<?xml version="1.0" encoding="utf-8"?>
<!-- Android refuses plain http:// addresses. Debug builds allow them for this device and for the computer the emulator
     runs on, which is 10.0.2.2 from inside the emulator, so cloud saves can use the Worker run there with npm run dev.
     Release builds have no such file, and refuse them everywhere. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
