// Wrangler's settings for the cloud saves Worker. See ui-rework/cloud-saves.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's address is https://saves.<account subdomain>.workers.dev.
  "name": "saves",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Workers Logs: one log entry for each request, with its CPU time, in the dashboard for 3 days.
  "observability": { "enabled": true },
  // The bucket that holds the saves. The Worker reaches it as env.SAVES.
  "r2_buckets": [{ "binding": "SAVES", "bucket_name": "modern-morrow-saves" }],
  // Requests per IP address in each minute. Each Cloudflare location counts on its own, and only roughly. The
  // namespace IDs only need to be unique within the Cloudflare account.
  "ratelimits": [
    { "name": "UPLOAD_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ]
}
