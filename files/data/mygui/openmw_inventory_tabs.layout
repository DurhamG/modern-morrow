<?xml version="1.0" encoding="UTF-8"?>

<!-- The tabs above the map, inventory, magic and stats screens in controller menus mode. InventoryTabsOverlay
     places the tabs in code. -->
<MyGUI type="Layout">
    <Widget type="Widget" skin="" layer="ControllerMenus" position="0 0 1280 44" align="HStretch Top" name="_Main">
        <Widget type="ImageBox" skin="ImageBox" position="0 0 1280 44" align="Stretch">
            <Property key="ImageTexture" value="white"/>
            <Property key="Colour" value="#000000"/>
            <Property key="Alpha" value="1"/>
            <Property key="NeedMouse" value="false"/>
        </Widget>
        <Widget type="ImageBox" skin="ImageBox" position="0 43 1280 1" align="HStretch Bottom">
            <Property key="ImageTexture" value="white"/>
            <Property key="Colour" value="#caa560"/>
            <Property key="Alpha" value="0.35"/>
            <Property key="NeedMouse" value="false"/>
        </Widget>
        <Widget type="ImageBox" skin="ImageBox" position="0 11 22 22" name="BtnL2Image">
            <Property key="Colour" value="#ccb589"/>
            <Property key="Alpha" value="0.85"/>
            <Property key="NeedMouse" value="false"/>
        </Widget>
        <Widget type="TextBox" skin="NormalText" position="0 0 120 44" name="TabMap">
            <Property key="Caption" value="#{sMap}"/>
        </Widget>
        <Widget type="TextBox" skin="NormalText" position="0 0 120 44" name="TabInventory">
            <Property key="Caption" value="#{sInventory}"/>
        </Widget>
        <Widget type="TextBox" skin="NormalText" position="0 0 120 44" name="TabSpells">
            <Property key="Caption" value="#{sMagicMenu}"/>
        </Widget>
        <Widget type="TextBox" skin="NormalText" position="0 0 120 44" name="TabStats">
            <Property key="Caption" value="#{sStats}"/>
        </Widget>
        <Widget type="ImageBox" skin="ImageBox" position="0 38 80 2" name="TabUnderline">
            <Property key="ImageTexture" value="white"/>
            <Property key="Colour" value="#caa560"/>
            <Property key="NeedMouse" value="false"/>
        </Widget>
        <Widget type="ImageBox" skin="ImageBox" position="0 11 22 22" name="BtnR2Image">
            <Property key="Colour" value="#ccb589"/>
            <Property key="Alpha" value="0.85"/>
            <Property key="NeedMouse" value="false"/>
        </Widget>
    </Widget>
</MyGUI>
